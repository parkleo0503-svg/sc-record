function openDbConfigModal() {
  const currentJson = customDbConfig ? JSON.stringify(customDbConfig, null, 2) : "";
  $("#mbody").innerHTML =
    '<h2>☁️ 공용 클라우드 DB 연결 (Firebase)</h2>' +
