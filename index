    '<div class="f"><label>Firebase Config JSON</label>' +
    '<textarea class="in" id="dbConfigInput" style="min-height:130px;font-family:monospace;font-size:12px" placeholder=\'{"apiKey":"...","authDomain":"...","projectId":"..."}\'>' + esc(currentJson) + '</textarea></div>' +
    '<div class="row" style="justify-content:space-between;gap:8px">' +
    '<button type="button" class="btn dg" data-a="resetDbConfig">기본값으로 복원</button>' +
    '<div class="row" style="gap:6px"><button type="button" class="btn" data-a="closeModal">취소</button><button type="button" class="btn pri" data-a="saveDbConfig">저장 및 적용</button></div></div>';
  $("#modal").classList.add("open");
}

const closeModal = () => {
  S.edit = null;
  $("#modal").classList.remove("open");
};

async function refreshFromCloud(showToast = false) {
  if (cloudBridge.enabled && cloudBridge.fetchAll) {
    try {
      setSyncLabel("불러오는 중…");
      const list = await cloudBridge.fetchAll();
      if (Array.isArray(list)) {
        matches = list.filter(valid).sort(cmp);
        saveLocalMatches(matches);
        updateLastRaces();
        setSyncLabel("클라우드 연결됨 (" + matches.length + "경기)");
        render();
        if (showToast) toast("최신 전적을 불러왔습니다.");
        return;
      }
    } catch (e) {
      console.warn("Cloud fetch failed:", e);
    }
  }
  matches = loadLocalMatches().sort(cmp);
  updateLastRaces();
  setSyncLabel("기기 저장 모드 (" + matches.length + "경기)");
  render();
  if (showToast) toast("기기 저장소에서 불러왔습니다.");
}

const ACT = {
  refreshData: () => refreshFromCloud(true),
  openDbConfig: openDbConfigModal,
  saveDbConfig: () => {
    const raw = ($("#dbConfigInput") && $("#dbConfigInput").value.trim()) || "";
    try {
      const parsed = JSON.parse(raw);
      if (!parsed || !parsed.apiKey || !parsed.projectId) throw 0;
      localStorage.setItem(CUSTOM_DB_KEY, JSON.stringify(parsed));
      toast("설정을 저장했습니다. 페이지를 새로고침합니다.");
      setTimeout(() => location.reload(), 600);
    } catch (e) {
      toast("올바른 JSON 형식이 아닙니다. apiKey와 projectId를 확인하세요.");
    }
  },
  resetDbConfig: () => {
    localStorage.removeItem(CUSTOM_DB_KEY);
    toast("기본 starecord DB 설정으로 복원합니다.");
    setTimeout(() => location.reload(), 600);
  },
  pick: (v) => {
    const i = S.sel.indexOf(v);
    if (i > -1) S.sel.splice(i, 1);
    else {
      if (S.sel.length >= 2) S.sel.shift();
      S.sel.push(v);
    }
    S.winner = null;
    S.step = S.sel.length === 2 ? 2 : 1;
    render();
  },
  race: (v, p) => {
    S.races[p] = v;
    render();
  },
  step: (v) => {
    S.step = +v;
    if (+v < 3) S.winner = null;
    render();
  },
  again: () => {
    const m = day().slice(-1)[0];
    if (!m) return;
    S.sel = m.players.slice();
    S.sel.forEach((p) => { S.races[p] = raceOf(m, p); });
    S.winner = null;
    S.step = 3;
    render();
  },
  win: (v) => {
    S.winner = v;
    render();
  },
  save: async () => {
    if (!S.winner || S.sel.length !== 2) return;
    const a = S.sel[0], b = S.sel[1];
    const nextSeq = day().length + 1;
    const m = {
      id: "m_" + Date.now() + "_" + Math.random().toString(36).slice(2, 6),
      date: S.date,
      seq: nextSeq,
      createdAt: Date.now(),
      map: "투혼",
      players: [a, b],
      winner: S.winner,
      races: {},
      builds: {},
      notes: {}
    };
    [a, b].forEach((p) => {
      m.races[p] = S.races[p];
      m.builds[p] = "-";
      m.notes[p] = "";
    });
    S.winner = null;
    S.sel = [];
    S.step = 1;
    await saveMatchToDB(m);
    toast("경기 #" + m.seq + " 결과를 반영했어요");
  },
  tab: (v) => {
    S.tab = v;
    renderTab();
  },
  scope: (v) => {
    S.scope = v;
    render();
  },
  prev: () => {
    S.date = shift(S.date, -1);
    S.sel = [];
    render();
  },
  next: () => {
    S.date = shift(S.date, 1);
    S.sel = [];
    render();
  },
  today: () => {
    S.date = fmt(new Date());
    render();
  },
  edit: (v) => openEdit(v),
  del: async (v) => {
    const m = matches.find((x) => x.id === v);
    if (!m) return;
    const backupMatch = JSON.parse(JSON.stringify(m));
    await deleteMatchFromDB(v);
    await reindexAndSyncDate(backupMatch.date);
    toast("경기를 삭제했어요", async () => {
      await saveMatchToDB(backupMatch);
      await reindexAndSyncDate(backupMatch.date);
    });
  },
  clearDay: async () => {
    const rm = day();
    if (!rm.length) {
      toast("지울 기록이 없어요");
      return;
    }
    const backupList = JSON.parse(JSON.stringify(rm));
    const rmIds = {};
    rm.forEach((m) => { rmIds[m.id] = 1; });
    matches = matches.filter((m) => !rmIds[m.id]);
    saveLocalMatches(matches);
    render();

    if (cloudBridge.enabled && cloudBridge.batchDelete) {
      try {
        await cloudBridge.batchDelete(rm.map((m) => m.id));
        setSyncLabel("클라우드 저장됨 (" + matches.length + "경기)");
      } catch (e) {
        console.warn("Clear day cloud error:", e);
      }
    } else {
      setSyncLabel("기기 저장 모드 (" + matches.length + "경기)");
    }

    toast(S.date + " 기록 " + rm.length + "경기를 지웠어요", async () => {
      matches = matches.concat(backupList).sort(cmp);
      saveLocalMatches(matches);
      render();
      if (cloudBridge.enabled && cloudBridge.batchSave) {
        try {
          await cloudBridge.batchSave(backupList);
        } catch (e) {}
      }
    });
  },
  undo: () => {
    if (undoFn) {
      undoFn();
      undoFn = null;
      $("#toast").classList.remove("open");
    }
  },
  kakao: () => {
    const t = summary();
    panel("카톡 공유용 전적", t, false);
    const ta = $("#ptxt");
    if (ta) {
      ta.select();
      ACT.copy();
    }
  },
  backup: () => {
    const restoreBtn = '<button type="button" class="btn" data-a="restore">붙여넣은 내용으로 복원</button>';
