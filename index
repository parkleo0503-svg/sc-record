<script>
const LOCAL_MATCHES_KEY = "sc_matches_local_v1";
const CUSTOM_DB_KEY = "sc_custom_firebase_cfg_v1";

const BUILTIN_FIREBASE_CONFIG = {
  apiKey: "AIzaSyBNN0l2LbInlP69bAig1poS4mISSta4tE4",
  authDomain: "starecord.firebaseapp.com",
  projectId: "starecord",
  storageBucket: "starecord.firebasestorage.app",
  messagingSenderId: "137075151654",
  appId: "1:137075151654:web:17956a313f8b714b8f67e7"
};

let customDbConfig = BUILTIN_FIREBASE_CONFIG;
try {
  const savedCfg = localStorage.getItem(CUSTOM_DB_KEY);
  if (savedCfg) {
    const parsed = JSON.parse(savedCfg);
    if (parsed && parsed.apiKey && parsed.projectId) customDbConfig = parsed;
  }
} catch (e) {}

const defaultAppId = typeof __app_id !== "undefined" ? __app_id : "default-app-id";
const appId = customDbConfig ? "shared-fighting-spirit" : defaultAppId;
const activeConfig = customDbConfig || BUILTIN_FIREBASE_CONFIG;

let matches = [];
let cloudBridge = {
  enabled: false,
  db: null,
  saveMatch: null,
  deleteMatch: null,
  batchSave: null,
  batchDelete: null,
  fetchAll: null
};

const P = [{ id: "L", n: "레오" }, { id: "G", n: "경섭" }, { id: "T", n: "태호" }];
const R = { Z: "저그", T: "테란", P: "프로토스" };
const B = {
  Z: ["럴커", "뮤탈", "목동"],
  T: ["바이오닉", "메카닉", "111"],
  P: ["질럿러시", "아비터", "캐리어", "선리버"]
};

const $ = (s) => document.querySelector(s);
const esc = (s) => String(s == null ? "" : s).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
const nm = (id) => {
  const found = P.find((p) => p.id === id);
  return found ? found.n : id;
};
const cmp = (a, b) => (a.date > b.date ? 1 : a.date < b.date ? -1 : 0) || (a.seq || 0) - (b.seq || 0) || (a.createdAt || 0) - (b.createdAt || 0);
const hasB = (b) => b && b !== "-";
const rate = (w, l) => (w + l ? Math.round((w / (w + l)) * 100) + "%" : "-");
const pad = (n) => String(n).padStart(2, "0");
const fmt = (d) => d.getFullYear() + "-" + pad(d.getMonth() + 1) + "-" + pad(d.getDate());
const shift = (s, n) => {
  const p = s.split("-");
  return fmt(new Date(+p[0], +p[1] - 1, +p[2] + n));
};
const valid = (m) => m && Array.isArray(m.players) && m.players.length === 2 && m.date && m.winner && m.id;

function readSeed() {
  try {
    const a = JSON.parse(document.getElementById("seed").textContent || "[]");
    return Array.isArray(a) ? a.filter(valid) : [];
  } catch (e) {
    return [];
  }
}

function saveLocalMatches(list) {
  try {
    localStorage.setItem(LOCAL_MATCHES_KEY, JSON.stringify(list));
  } catch (e) {}
}

function loadLocalMatches() {
  try {
    const raw = localStorage.getItem(LOCAL_MATCHES_KEY);
    if (raw) {
      const parsed = JSON.parse(raw);
      if (Array.isArray(parsed)) return parsed.filter(valid);
    }
  } catch (e) {}
  const seed = readSeed();
  saveLocalMatches(seed);
  return seed;
}

const S = {
  step: 1,
  date: fmt(new Date()),
  scope: "day",
  tab: "list",
  sel: [],
  races: { L: "Z", G: "T", T: "P" },
  winner: null,
  builds: {},
  notes: {},
  edit: null,
  q: "",
  bp: "ALL"
};

try {
  const s0 = JSON.parse(sessionStorage.getItem("sc_s") || "null");
  if (s0) Object.keys(s0).forEach((k) => { S[k] = s0[k]; });
} catch (e) {}

function updateLastRaces() {
  const r = { L: "Z", G: "T", T: "P" };
  matches.slice().sort(cmp).forEach((m) => {
    m.players.forEach((p) => {
      if (m.races && m.races[p]) r[p] = m.races[p];
    });
  });
  if (S.step === 1 && S.sel.length === 0) {
    S.races = r;
  }
}

const day = () => matches.filter((m) => m.date === S.date).sort(cmp);
const scoped = () => (S.scope === "day" ? day() : matches.slice().sort(cmp));
const loserOf = (m) => (m.winner === m.players[0] ? m.players[1] : m.players[0]);
const raceOf = (m, p) => (m.races && m.races[p]) || "?";

let tt = null, undoFn = null;
function toast(msg, undo) {
  const t = $("#toast");
  if (!t) return;
  undoFn = undo || null;
  t.innerHTML = "<span>" + esc(msg) + "</span>" + (undo ? '<button type="button" data-a="undo">되돌리기</button>' : "");
  t.classList.add("open");
  clearTimeout(tt);
  tt = setTimeout(() => {
    t.classList.remove("open");
    undoFn = null;
  }, undo ? 7000 : 2800);
}

function setSyncLabel(text) {
  const el = $("#sync");
  if (el) el.textContent = text;
}

async function saveMatchToDB(matchObj) {
  const idx = matches.findIndex((x) => x.id === matchObj.id);
  if (idx > -1) matches[idx] = matchObj;
  else matches.push(matchObj);
  matches.sort(cmp);
  saveLocalMatches(matches);
  render();

  if (cloudBridge.enabled && cloudBridge.saveMatch) {
    try {
      await cloudBridge.saveMatch(matchObj);
      setSyncLabel("클라우드 저장됨 (" + matches.length + "경기)");
    } catch (e) {
      console.warn("Cloud save error:", e);
      toast("기기에 저장됨 (클라우드 규칙 확인 필요)");
    }
  } else {
    setSyncLabel("기기 저장 모드 (" + matches.length + "경기)");
  }
}

async function deleteMatchFromDB(id) {
  matches = matches.filter((x) => x.id !== id);
  saveLocalMatches(matches);
  render();

  if (cloudBridge.enabled && cloudBridge.deleteMatch) {
    try {
      await cloudBridge.deleteMatch(id);
      setSyncLabel("클라우드 저장됨 (" + matches.length + "경기)");
    } catch (e) {
      console.warn("Cloud delete error:", e);
      toast("기기에서 삭제됨 (클라우드 동기화 실패)");
    }
  } else {
    setSyncLabel("기기 저장 모드 (" + matches.length + "경기)");
  }
}

async function reindexAndSyncDate(dateStr) {
  const dayMatches = matches.filter((m) => m.date === dateStr).sort(cmp);
  const updated = [];
  dayMatches.forEach((m, idx) => {
    if (m.seq !== idx + 1) {
      m.seq = idx + 1;
      updated.push(m);
    }
  });
  saveLocalMatches(matches);
  render();

  if (updated.length > 0 && cloudBridge.enabled && cloudBridge.batchSave) {
    try {
      await cloudBridge.batchSave(updated);
    } catch (e) {
      console.warn("Reindex cloud error:", e);
    }
  }
}

function stats(list) {
  const o = {};
  P.forEach((p) => { o[p.id] = { w: 0, l: 0, st: 0, f: [] }; });
  list.forEach((m) => {
    const a = m.players[0], b = m.players[1];
    if (!o[a] || !o[b]) return;
    const w = m.winner, l = loserOf(m);
    if (!o[w]) return;
    o[w].w++;
    o[w].st = o[w].st > 0 ? o[w].st + 1 : 1;
    o[w].f.push("W");
    o[l].l++;
    o[l].st = o[l].st < 0 ? o[l].st - 1 : -1;
    o[l].f.push("L");
  });
  return o;
}

function bar(w, l) {
  const t = w + l;
  return '<div class="bar" title="' + w + "승 " + l + '패"><i class="w" style="width:' + (t ? (w / t) * 100 : 0) + '%"></i><i class="l" style="width:' + (t ? (l / t) * 100 : 0) + '%"></i></div>';
}

const stTxt = (x) => (x.st > 0 ? x.st + "연승" : x.st < 0 ? -x.st + "연패" : "기록 없음");

function renderStrip() {
  const s = stats(scoped());
  $("#strip").innerHTML = P.map((p) => {
    const x = s[p.id];
    return (
      '<div class="card"><div class="row"><b>' + p.n + "</b><span>" + x.w + "승 " + x.l + "패 · " + rate(x.w, x.l) + "</span></div>" +
      bar(x.w, x.l) +
      '<div class="row m"><span class="dots" aria-label="최근 5경기">' +
      x.f.slice(-5).map((f) => '<i class="d ' + f + '"></i>').join("") +
      '</span><span class="st ' + (x.st > 0 ? "w" : x.st < 0 ? "l" : "") + '">' + stTxt(x) + "</span></div></div>"
    );
  }).join("");
}

function head(step, sub) {
  return (
    '<div class="row" style="margin-bottom:8px"><h2 style="margin:0">' + S.date + " · 경기 #" + (day().length + 1) +
    '</h2><span class="steps">' +
    ["선수", "종족", "승패"].map((t, i) => '<span class="sp' + (step === i + 1 ? " on" : step > i + 1 ? " ok" : "") + '">' + (i + 1) + ". " + t + "</span>").join("") +
    '</span></div><p class="m" style="margin-bottom:12px">' + sub + "</p>"
  );
}

function renderWiz() {
  const a = S.sel[0], b = S.sel[1];
  let h = "";
  if (S.step === 1 || S.sel.length < 2) {
    const last = day().slice(-1)[0];
    h =
      head(1, "출전할 선수 2명을 고르세요 (" + S.sel.length + "/2)") +
      '<div class="pick">' +
      P.map((p) => {
        const on = S.sel.indexOf(p.id) > -1;
        return '<button type="button" class="pk' + (on ? " on" : "") + '" data-a="pick" data-v="' + p.id + '"><span class="pn">' + p.n + '</span><span class="m">' + (on ? "선택됨" : "탭해서 선택") + "</span></button>";
      }).join("") +
      "</div>" +
      (last ? '<div class="foot"><button type="button" class="btn" data-a="again">↺ 방금 대결 한 판 더 · ' + nm(last.players[0]) + " vs " + nm(last.players[1]) + "</button></div>" : "");
  } else if (S.step === 2) {
    h =
      head(2, "각 선수의 종족을 고르세요") +
      '<div class="duo">' +
      [a, b].map((p) => {
        return (
          '<div class="col"><div class="cn">' + nm(p) + "</div>" +
          Object.keys(R).map((k) => '<button type="button" class="rk r' + k + (S.races[p] === k ? " on" : "") + '" data-a="race" data-p="' + p + '" data-v="' + k + '"><b>' + k + "</b> " + R[k] + "</button>").join("") +
          "</div>"
        );
      }).join("") +
      '</div><div class="foot"><button type="button" class="btn" data-a="step" data-v="1">← 선수 다시 선택</button><button type="button" class="btn pri" data-a="step" data-v="3">다음</button></div>';
  } else {
    h =
      head(3, "이긴 선수를 탭하세요") +
      '<div class="duo">' +
      [a, b].map((p) => {
        const w = S.winner === p, lo = S.winner && !w;
        return (
          '<button type="button" class="fc' + (w ? " win" : "") + (lo ? " lose" : "") + '" data-a="win" data-v="' + p + '"><span class="m">' +
          (w ? "✓ 승리" : lo ? "패배" : "탭해서 선택") +
          '</span><span class="pn">' + nm(p) + '</span><span class="rc ' + S.races[p] + '" style="font-size:18px">' + S.races[p] + " · " + R[S.races[p]] + "</span></button>"
        );
      }).join("") +
      '</div><div class="foot"><button type="button" class="btn" data-a="step" data-v="2">← 종족 다시 선택</button><button type="button" class="btn bw" data-a="save"' + (S.winner ? "" : " disabled") + ">확인 · 결과 반영</button></div>";
  }
  $("#wiz").innerHTML = h;
}

function item(m) {
  const w = m.winner, l = loserOf(m);
  function side(p, tag) {
    const bd = m.builds && m.builds[p], nt = m.notes && m.notes[p];
    return (
      '<span class="tag ' + tag + '">' + (tag === "w" ? "승" : "패") + "</span> <b>" + nm(p) +
      '</b> <span class="rc ' + raceOf(m, p) + '">' + raceOf(m, p) + "</span>" +
      (hasB(bd) ? ' <span class="pill">' + esc(bd) + "</span>" : "") +
      (nt ? ' <span class="m">' + esc(nt) + "</span>" : "")
    );
  }
  const actionBtns =
    '<div style="display:flex;gap:6px"><button type="button" class="btn" data-a="edit" data-v="' + esc(m.id) + '">수정</button><button type="button" class="btn dg" data-a="del" data-v="' + esc(m.id) + '">삭제</button></div>';

  return (
    '<div class="mi"><div><span class="m">' + (S.scope === "all" ? m.date.slice(5) + " " : "") + "#" + m.seq + "</span> " +
    side(w, "w") + ' <span class="m">vs</span> ' + side(l, "l") + "</div>" + actionBtns + "</div>"
  );
}

function tabList() {
  const l = scoped().slice().reverse();
  const emptyMsg = "기록된 경기가 없습니다. 위에서 선수 2명을 골라 첫 경기를 기록하세요.";
  return '<div class="card"><h2>' + (S.scope === "day" ? S.date : "전체") + " 경기 (" + l.length + ")</h2>" + (l.length ? l.map(item).join("") : '<p class="m">' + emptyMsg + "</p>") + "</div>";
}

function tabH2H() {
  const l = scoped(), pairs = [[0, 1], [0, 2], [1, 2]];
  return (
    '<div class="g3x">' +
    pairs.map((pr) => {
      const a = P[pr[0]], b = P[pr[1]];
      let wa = 0, wb = 0;
      const logs = [];
      l.forEach((m) => {
        if (m.players.indexOf(a.id) > -1 && m.players.indexOf(b.id) > -1) {
          m.winner === a.id ? wa++ : wb++;
          logs.push(m);
        }
      });
      return (
        '<div class="h2h"><div class="row"><b>' + a.n + " vs " + b.n + '</b><span class="m">' + (wa + wb) + "판</span></div>" +
        '<div class="row" style="font-weight:800;margin-top:6px"><span>' + a.n + " " + wa + "승</span><span>" + wb + "승 " + b.n + "</span></div>" +
        bar(wa, wb) +
        (logs.length
          ? logs.slice(-6).reverse().map((m) => '<div class="m" style="display:flex;justify-content:space-between;padding:3px 0"><span>' + (S.scope === "all" ? m.date.slice(5) + " " : "") + "#" + m.seq + " " + raceOf(m, a.id) + " vs " + raceOf(m, b.id) + '</span><b class="w">' + nm(m.winner) + "</b></div>").join("")
          : '<p class="m">기록 없음</p>') +
        "</div>"
      );
    }).join("") +
    "</div>"
  );
}

function tabRace() {
  const l = scoped(), rs = { Z: [0, 0], T: [0, 0], P: [0, 0] }, mu = {}, pr = {};
  P.forEach((p) => { pr[p.id] = { Z: [0, 0], T: [0, 0], P: [0, 0] }; });
  l.forEach((m) => {
    const w = m.winner, lo = loserOf(m), wr = raceOf(m, w), lr = raceOf(m, lo);
    if (!rs[wr] || !rs[lr]) return;
    rs[wr][0]++;
    rs[lr][1]++;
    if (pr[w]) pr[w][wr][0]++;
    if (pr[lo]) pr[lo][lr][1]++;
    const k = [wr, lr].sort(), key = k[0] + " vs " + k[1];
    mu[key] = mu[key] || { g: 0, a: 0, b: 0, k: k };
    mu[key].g++;
    if (wr !== lr) {
      wr === k[0] ? mu[key].a++ : mu[key].b++;
    }
  });
  const rows = Object.keys(R).map((r) => '<tr><td><b class="rc ' + r + '">' + r + "</b> " + R[r] + '</td><td class="w">' + rs[r][0] + '</td><td class="l">' + rs[r][1] + "</td><td>"+ rate(rs[r][0], rs[r][1]) + '</td><td style="min-width:100px">' + bar(rs[r][0], rs[r][1]) + "</td></tr>").join("");
  const mk = Object.keys(mu).sort((a, b) => mu[b].g - mu[a].g);
  return (
    '<div class="card"><h2>종족별 승률</h2><div class="tw"><table><tr><th>종족</th><th>승</th><th>패</th><th>승률</th><th></th></tr>' + rows + "</table></div></div>" +
    '<div class="card"><h2>종족 상성</h2>' +
    (mk.length
      ? '<div class="tw"><table><tr><th>매치업</th><th>경기</th><th>결과</th></tr>' +
        mk.map((k) => {
          const x = mu[k];
          return "<tr><td><b>" + k + "</b></td><td>" + x.g + "</td><td>" + (x.k[0] === x.k[1] ? "미러전" : x.k[0] + " " + x.a + "승 · " + x.k[1] + " " + x.b + "승") + "</td></tr>";
        }).join("") +
        "</table></div>"
      : '<p class="m">기록 없음</p>') +
    "</div>" +
    '<div class="card"><h2>선수별 종족 성적</h2><div class="tw"><table><tr><th>선수</th><th>Z</th><th>T</th><th>P</th></tr>' +
    P.map((p) => {
      return (
        "<tr><td><b>" + p.n + "</b></td>" +
        ["Z", "T", "P"].map((r) => {
          const x = pr[p.id][r];
          return "<td>" + (x[0] + x[1] ? x[0] + "승 " + x[1] + '패 <span class="m">' + rate(x[0], x[1]) + "</span>" : '<span class="m">-</span>') + "</td>";
        }).join("") +
        "</tr>"
      );
    }).join("") +
    "</table></div></div>"
  );
}

function tabBuild() {
  return (
    '<div class="card"><h2>빌드 승률 · 메모</h2><div class="f2"><select class="in" id="bp"><option value="ALL">전체 선수</option>' +
    P.map((p) => '<option value="' + p.id + '"' + (S.bp === p.id ? " selected" : "") + ">" + p.n + "</option>").join("") +
    '</select><input class="in" id="bq" placeholder="빌드 · 메모 검색" value="' + esc(S.q) + '"></div><div id="bres"></div></div>'
  );
}

function fillBuild() {
  const rows = [], q = S.q.trim().toLowerCase();
  scoped().forEach((m) => {
    m.players.forEach((p) => {
      if (S.bp !== "ALL" && p !== S.bp) return;
      const r = raceOf(m, p), b = (m.builds && m.builds[p]) || "-", n = (m.notes && m.notes[p]) || "";
      if (!hasB(b) && !n) return;
      if (q && (nm(p) + " " + r + " " + b + " " + n).toLowerCase().indexOf(q) < 0) return;
      rows.push({ m: m, p: p, r: r, b: b, n: n, win: m.winner === p });
    });
  });
  const ag = {};
  rows.forEach((x) => {
    if (!hasB(x.b)) return;
    const k = x.r + " " + x.b;
    ag[k] = ag[k] || [0, 0];
    x.win ? ag[k][0]++ : ag[k][1]++;
  });
  const ks = Object.keys(ag).sort((a, b) => ag[b][0] + ag[b][1] - ag[a][0] - ag[a][1]);
  $("#bres").innerHTML =
    (ks.length
      ? '<div class="tw"><table><tr><th>빌드</th><th>승</th><th>패</th><th>승률</th></tr>' +
        ks.map((k) => '<tr><td><b>' + esc(k) + '</b></td><td class="w">' + ag[k][0] + '</td><td class="l">' + ag[k][1] + "</td><td>" + rate(ag[k][0], ag[k][1]) + "</td></tr>").join("") +
        "</table></div>"
      : "") +
    (rows.length
      ? '<div style="margin-top:12px">' +
        rows.slice().reverse().map((x) => '<div class="mi"><div><span class="m">' + x.m.date.slice(5) + " #" + x.m.seq + "</span> <b>" + nm(x.p) + '</b> <span class="rc ' + x.r + '">' + x.r + "</span> " + (hasB(x.b) ? '<span class="pill">' + esc(x.b) + "</span> " : "") + '<span class="m">' + esc(x.n) + '</span></div><span class="tag ' + (x.win ? "w" : "l") + '">' + (x.win ? "승" : "패") + "</span></div>").join("") +
        "</div>"
      : '<p class="m">선택한 빌드나 메모 기록이 없습니다.</p>');
}

function renderTab() {
  document.querySelectorAll("#tabs button").forEach((b) => b.classList.toggle("on", b.dataset.v === S.tab));
  const h = { list: tabList, h2h: tabH2H, race: tabRace, build: tabBuild }[S.tab]();
  $("#tab").innerHTML = h;
  if (S.tab === "build") {
    fillBuild();
    $("#bp").onchange = (e) => { S.bp = e.target.value; fillBuild(); };
    $("#bq").oninput = (e) => { S.q = e.target.value; fillBuild(); };
  }
}

function render() {
  try {
    sessionStorage.setItem("sc_s", JSON.stringify({ step: S.step, sel: S.sel, races: S.races, winner: S.winner, date: S.date, scope: S.scope, tab: S.tab }));
  } catch (e) {}
  if ($("#date")) $("#date").value = S.date;
  document.querySelectorAll("#scope button").forEach((b) => b.classList.toggle("on", b.dataset.v === S.scope));
  renderStrip();
  renderWiz();
  renderTab();
}

function summary() {
  const l = day(), s = stats(l), t = ["[투혼 1:1 전적 · " + S.date + "]"];
  P.forEach((p) => {
    const x = s[p.id];
    t.push(p.n + ": " + x.w + "승 " + x.l + "패 (" + rate(x.w, x.l) + ")" + (x.st > 1 ? " " + x.st + "연승 중" : x.st < -1 ? " " + -x.st + "연패 중" : ""));
  });
  if (l.length) {
    t.push("");
    l.forEach((m) => {
      const w = m.winner, lo = loserOf(m);
      t.push("#" + m.seq + " " + nm(w) + "(" + raceOf(m, w) + ") 승 vs " + nm(lo) + "(" + raceOf(m, lo) + ")");
    });
  }
  return t.join("\n");
}

