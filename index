  function blk(p, k) {
    return (
      '<div class="f"><label>' + nm(p) + ' 종족 · 빌드 · 메모</label><div class="f2"><select class="in" id="er' + k + '">' +
      Object.keys(R).map((r) => '<option value="' + r + '"' + (raceOf(m, p) === r ? " selected" : "") + ">" + r + " " + R[r] + "</option>").join("") +
