async function refreshFromCloud(showToast = false) {
  if (cloudBridge.enabled && cloudBridge.fetchAll) {
    try {
      setSyncLabel("불러오는 중…");
      const list = await cloudBridge.fetchAll();
      if (Array.isArray(list)) {
        matches = list.filter(valid).sort(cmp);
        saveLocalMatches(matches);
        updateLastRaces();
        setSyncLabel("클라우드 연결됨 (" + matches.length + "경기)");
        render();
        if (showToast) toast("최신 전적을 불러왔습니다.");
        return;
      }
    } catch (e) {
      console.warn("Cloud fetch failed:", e);
    }
  }
  matches = loadLocalMatches().sort(cmp);
  updateLastRaces();
  setSyncLabel("기기 저장 모드 (" + matches.length + "경기)");
  render();
  if (showToast) toast("기기 저장소에서 불러왔습니다.");
}

const ACT = {
  refreshData: () => refreshFromCloud(true),
  openDbConfig: openDbConfigModal,
  saveDbConfig: () => {
    const raw = ($("#dbConfigInput") && $("#dbConfigInput").value.trim()) || "";
    try {
      const parsed = JSON.parse(raw);
      if (!parsed || !parsed.apiKey || !parsed.projectId) throw 0;
      localStorage.setItem(CUSTOM_DB_KEY, JSON.stringify(parsed));
      toast("설정을 저장했습니다. 페이지를 새로고침합니다.");
      setTimeout(() => location.reload(), 600);
    } catch (e) {
      toast("올바른 JSON 형식이 아닙니다. apiKey와 projectId를 확인하세요.");
    }
  },
  resetDbConfig: () => {
    localStorage.removeItem(CUSTOM_DB_KEY);
    toast("기본 starecord DB 설정으로 복원합니다.");
    setTimeout(() => location.reload(), 600);
  },
  pick: (v) => {
    const i = S.sel.indexOf(v);
    if (i > -1) S.sel.splice(i, 1);
    else {
      if (S.sel.length >= 2) S.sel.shift();
      S.sel.push(v);
    }
    S.winner = null;
    S.step = S.sel.length === 2 ? 2 : 1;
    render();
  },
  race: (v, p) => {
    S.races[p] = v;
    render();
  },
  step: (v) => {
    S.step = +v;
    if (+v < 3) S.winner = null;
    render();
  },
  again: () => {
    const m = day().slice(-1)[0];
    if (!m) return;
    S.sel = m.players.slice();
    S.sel.forEach((p) => { S.races[p] = raceOf(m, p); });
    S.winner = null;
    S.step = 3;
    render();
  },
  win: (v) => {
    S.winner = v;
    render();
  },
  save: async () => {
    if (!S.winner || S.sel.length !== 2) return;
    const a = S.sel[0], b = S.sel[1];
    const nextSeq = day().length + 1;
    const m = {
      id: "m_" + Date.now() + "_" + Math.random().toString(36).slice(2, 6),
      date: S.date,
      seq: nextSeq,
      createdAt: Date.now(),
      map: "투혼",
      players: [a, b],
      winner: S.winner,
      races: {},
      builds: {},
      notes: {}
    };
    [a, b].forEach((p) => {
      m.races[p] = S.races[p];
      m.builds[p] = "-";
      m.notes[p] = "";
    });
    S.winner = null;
    S.sel = [];
    S.step = 1;
    await saveMatchToDB(m);
    toast("경기 #" + m.seq + " 결과를 반영했어요");
  },
  tab: (v) => {
    S.tab = v;
    renderTab();
  },
  scope: (v) => {
    S.scope = v;
    render();
  },
  prev: () => {
    S.date = shift(S.date, -1);
    S.sel = [];
    render();
  },
  next: () => {
    S.date = shift(S.date, 1);
    S.sel = [];
    render();
  },
  today: () => {
    S.date = fmt(new Date());
    render();
  },
  edit: (v) => openEdit(v),
  del: async (v) => {
    const m = matches.find((x) => x.id === v);
    if (!m) return;
    const backupMatch = JSON.parse(JSON.stringify(m));
    await deleteMatchFromDB(v);
    await reindexAndSyncDate(backupMatch.date);
    toast("경기를 삭제했어요", async () => {
      await saveMatchToDB(backupMatch);
      await reindexAndSyncDate(backupMatch.date);
    });
  },
  clearDay: async () => {
    const rm = day();
    if (!rm.length) {
      toast("지울 기록이 없어요");
      return;
    }
    const backupList = JSON.parse(JSON.stringify(rm));
    const rmIds = {};
    rm.forEach((m) => { rmIds[m.id] = 1; });
    matches = matches.filter((m) => !rmIds[m.id]);
    saveLocalMatches(matches);
    render();

    if (cloudBridge.enabled && cloudBridge.batchDelete) {
      try {
        await cloudBridge.batchDelete(rm.map((m) => m.id));
        setSyncLabel("클라우드 저장됨 (" + matches.length + "경기)");
      } catch (e) {
        console.warn("Clear day cloud error:", e);
      }
    } else {
      setSyncLabel("기기 저장 모드 (" + matches.length + "경기)");
    }

    toast(S.date + " 기록 " + rm.length + "경기를 지웠어요", async () => {
      matches = matches.concat(backupList).sort(cmp);
      saveLocalMatches(matches);
      render();
      if (cloudBridge.enabled && cloudBridge.batchSave) {
        try {
          await cloudBridge.batchSave(backupList);
        } catch (e) {}
      }
    });
  },
  undo: () => {
    if (undoFn) {
      undoFn();
      undoFn = null;
      $("#toast").classList.remove("open");
    }
  },
  kakao: () => {
    const t = summary();
    panel("카톡 공유용 전적", t, false);
    const ta = $("#ptxt");
    if (ta) {
      ta.select();
      ACT.copy();
    }
  },
  backup: () => {
    const restoreBtn = '<button type="button" class="btn" data-a="restore">붙여넣은 내용으로 복원</button>';
    const desc = '<p class="m" style="margin:-4px 0 12px 4px">백업 JSON 데이터를 복사해 보관하거나, 붙여넣은 뒤 복원하면 기존 기록에 합쳐집니다.</p>';
    panel("백업 · 복원", JSON.stringify(matches), true, restoreBtn);
    $("#panel").insertAdjacentHTML("beforeend", desc);
  },
  restore: async () => {
    try {
      const a = JSON.parse($("#ptxt").value);
      if (!Array.isArray(a)) throw 0;
      const ids = {};
      matches.forEach((m) => { ids[m.id] = 1; });
      const add = a.filter((m) => valid(m) && !ids[m.id]);
      if (!add.length) {
        toast("새로 추가할 기록이 없습니다.");
        return;
      }
      matches = matches.concat(add).sort(cmp);
      const datesToReindex = {};
      add.forEach((m) => { datesToReindex[m.date] = 1; });

      Object.keys(datesToReindex).forEach((d) => {
        matches.filter((m) => m.date === d).sort(cmp).forEach((m, i) => { m.seq = i + 1; });
      });

      saveLocalMatches(matches);
      render();

      if (cloudBridge.enabled && cloudBridge.batchSave) {
        try {
          const toSync = matches.filter((m) => add.some((x) => x.id === m.id) || datesToReindex[m.date]);
          await cloudBridge.batchSave(toSync);
        } catch (e) {
          console.warn("Restore cloud error:", e);
        }
      }
      toast("새 기록 " + add.length + "경기를 합쳤어요");
    } catch (e) {
      toast("복원할 수 없는 형식이에요. 백업 내용을 통째로 붙여넣어 주세요.");
    }
  },
  copy: () => {
    const ta = $("#ptxt");
    if (!ta) return;
    ta.focus();
    ta.select();
    try {
      document.execCommand("copy") ? toast("복사했어요") : toast("선택된 내용을 직접 복사해 주세요");
    } catch (e) {
      toast("선택된 내용을 직접 복사해 주세요");
    }
  },
  closePanel: () => { $("#panel").innerHTML = ""; },
  closeModal: closeModal,
  saveEdit: async () => {
    const m = matches.find((x) => x.id === S.edit);
    if (!m) { closeModal(); return; }
    const a = m.players[0], b = m.players[1];
    m.winner = $("#ew").value;
    m.races = m.races || {};
    m.builds = m.builds || {};
    m.notes = m.notes || {};
    [[a, "a"], [b, "b"]].forEach((x) => {
      m.races[x[0]] = $("#er" + x[1]).value;
      m.builds[x[0]] = $("#eb" + x[1]).value.trim() || "-";
      m.notes[x[0]] = $("#en" + x[1]).value.trim();
    });
    closeModal();
    await saveMatchToDB(m);
    toast("수정했어요");
  }
};

function handleActionEvent(e) {
  const t = e.target.closest("[data-a]");
  if (!t) return;
  const action = t.dataset.a;
  if (ACT[action]) {
    ACT[action](t.dataset.v, t.dataset.p);
  }
}

document.addEventListener("click", handleActionEvent);

const dateEl = $("#date");
if (dateEl) {
  dateEl.addEventListener("change", (e) => {
    if (e.target.value) {
      S.date = e.target.value;
      S.sel = [];
      render();
    }
  });
}

matches = loadLocalMatches().sort(cmp);
updateLastRaces();
setSyncLabel("기기 저장 모드 (" + matches.length + "경기)");
render();

window.__scBridgeReady = async function (bridge) {
  cloudBridge = Object.assign(cloudBridge, bridge);
  await refreshFromCloud(false);
};
</script>

<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
import { getAuth, signInAnonymously } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
import { getFirestore, doc, getDocs, setDoc, deleteDoc, collection, writeBatch } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

try {
  const app = initializeApp(activeConfig);
  const auth = getAuth(app);
  const db = getFirestore(app);

  try {
    await signInAnonymously(auth);
  } catch (authErr) {
    console.warn("Anonymous sign-in skipped:", authErr);
  }

  const matchesColRef = () => collection(db, "artifacts", appId, "public", "data", "matches");
  const matchDocRef = (id) => doc(db, "artifacts", appId, "public", "data", "matches", id);

  const fetchAll = async () => {
    const snapshot = await getDocs(matchesColRef());
    const list = [];
    snapshot.forEach((docSnap) => {
      const data = docSnap.data();
      if (valid(data)) list.push(data);
    });
    return list;
  };

  const saveMatch = async (matchObj) => {
    await setDoc(matchDocRef(matchObj.id), matchObj);
  };

  const deleteMatch = async (id) => {
    await deleteDoc(matchDocRef(id));
  };

  const batchSave = async (list) => {
    const batch = writeBatch(db);
    list.forEach((m) => batch.set(matchDocRef(m.id), m));
    await batch.commit();
  };

  const batchDelete = async (ids) => {
    const batch = writeBatch(db);
    ids.forEach((id) => batch.delete(matchDocRef(id)));
    await batch.commit();
  };

  if (window.__scBridgeReady) {
    await window.__scBridgeReady({
      enabled: true,
      db,
      fetchAll,
      saveMatch,
      deleteMatch,
      batchSave,
      batchDelete
    });
  }
} catch (err) {
  console.warn("Firebase module unavailable, keeping local mode:", err);
}
</script>
